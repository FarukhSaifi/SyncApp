# Copy to .env.dev for local development
# Placeholder values only — never commit real secrets.

NODE_ENV=development
PORT=9000

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/syncapp

JWT_SECRET=your_secure_random_string_here_min_32_chars

# Generate 64-hex char key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_key_here

# Google Cloud Storage bucket for post cover uploads (set to your GCS bucket name)
GCS_BUCKET_NAME=your-gcs-bucket-name

CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- AI (Vertex AI — preferred) ---
# Enable AI Platform API on your GCP project, then set:
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_AI_MODEL=gemini-3.8-flash
# Local auth when SA key download is blocked by org policy:
#   gcloud auth application-default login --project=your-gcp-project-id
# Then point at ADC (gitignored) — see docs/AI_SETUP.md
GOOGLE_APPLICATION_CREDENTIALS=/Users/YOU/.config/gcloud/application_default_credentials.json
# Presigned cover uploads with user ADC impersonate the Vertex SA for V4 signing.
# Grant your user roles/iam.serviceAccountTokenCreator on that SA (or set SA JSON).
# Optional override (defaults to the project Vertex SA email in code):
# GCS_SIGNING_SERVICE_ACCOUNT=your-sa@your-gcp-project-id.iam.gserviceaccount.com
# If org policy allows SA keys instead:
# GOOGLE_APPLICATION_CREDENTIALS=../google-credentials.json
# Studio fallback only — do NOT top up AI Studio billing when credits are depleted:
# GEMINI_API_KEY=your-gemini-api-key-here
# AI_USE_GOOGLE_SEARCH_RETRIEVAL=false

# Public blog base for LinkedIn “Read more” + article canonicals
# CANONICAL_BASE_URL=https://yourblog.example.com/blog

# GA4 Data API (public blog property — numeric id from Admin → Property settings)
# See docs/GA4_SETUP.md. Measurement ID (G-…) goes on the blog only, not here.
# GOOGLE_ANALYTICS_PROPERTY_ID=123456789

# Cron Bearer auth for /api/cron/* (required in production; recommended locally for cron smoke tests)
# CRON_SECRET=your-cron-secret-here

# Scheduled publish notifications (optional locally; set in production)
# SLACK_WEBHOOK_URL=https://example.com/slack/incoming-webhook-placeholder
# RESEND_API_KEY=re_your_resend_api_key_here
# NOTIFICATION_FROM_EMAIL=SyncApp <noreply@yourdomain.example.com>
# NOTIFICATION_CC_EMAIL=you@example.com
# SITE_URL=https://your-app.example.com

# LinkedIn OAuth (optional)
# LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# LINKEDIN_REDIRECT_URI=http://localhost:9000/api/linkedin/oauth/callback
