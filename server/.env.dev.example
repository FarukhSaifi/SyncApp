# Copy to .env.dev for local development

NODE_ENV=development
PORT=9000

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/syncapp

JWT_SECRET=your_secure_random_string_here_min_32_chars

# Generate 64-hex char key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_key_here

# Google Cloud Storage bucket name for post cover uploads
GCS_BUCKET_NAME=your-bucket-name.firebasestorage.app

CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- AI (Google AI Studio) ---
# Free key from https://aistudio.google.com/apikey (starts with AIza)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_AI_MODEL=gemini-3.8-flash
# AI_USE_GOOGLE_SEARCH_RETRIEVAL=false

# --- GCS / Firebase Service Account (for signed upload URLs) ---
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_APPLICATION_CREDENTIALS=../google-credentials.json

# Vercel Cron (Bearer token for GET /api/cron/publish-scheduled)
# CRON_SECRET=your_cron_secret

# Scheduled publish notifications (optional locally; set in production)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# RESEND_API_KEY=re_...
# NOTIFICATION_FROM_EMAIL=SyncApp <noreply@yourdomain.com>
# NOTIFICATION_CC_EMAIL=farook1x95@gmail.com
# SITE_URL=https://your-app.vercel.app
