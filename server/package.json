{
  "name": "syncapp-server",
  "version": "2.0.0",
  "description": "Backend API server for SyncApp",
  "main": "dist/src/index.js",
  "scripts": {
    "start": "APP_ENV=prod node dist/src/index.js",
    "dev": "APP_ENV=dev nodemon --watch src --watch .env.dev --watch .env --ext ts,js,json,dev --exec 'tsx src/index.ts'",
    "build": "tsc && tsc-alias -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src api --report-unused-disable-directives --max-warnings 10",
    "db:setup": "APP_ENV=dev tsx src/database/setup.ts",
    "vercel-build": "tsc && tsc-alias -p tsconfig.json",
    "env:sync": "node scripts/sync-vercel-env.mjs"
  },
  "dependencies": {
    "@google-analytics/data": "^7.3.0",
    "@google-cloud/storage": "^8.4.0",
    "@google/genai": "2.31.0",
    "axios": "1.20.0",
    "bcryptjs": "3.0.3",
    "compression": "^1.8.2",
    "cors": "2.8.6",
    "dayjs": "1.11.23",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.11.4",
    "resend": "^6.34.1",
    "slugify": "1.6.9",
    "turndown": "^7.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.6.5",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "17.13.0",
    "nodemon": "3.1.14",
    "tsc-alias": "^1.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "gaxios": "^7.1.5",
    "google-auth-library": "^10.7.0"
  }
}
