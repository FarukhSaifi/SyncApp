{
  "name": "syncapp-server",
  "version": "2.0.0",
  "description": "Backend API server for SyncApp",
  "main": "dist/src/index.js",
  "scripts": {
    "start": "APP_ENV=prod node dist/src/index.js",
    "dev": "APP_ENV=dev nodemon --watch src --watch .env.dev --watch .env --ext ts,js,json,dev --exec 'tsx src/index.ts'",
    "build": "tsc && tsc-alias -p tsconfig.json && npm run openapi:copy",
    "openapi:copy": "mkdir -p dist/src/openapi && cp src/openapi/openapi.yaml dist/src/openapi/openapi.yaml",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "mkdir -p coverage/.tmp && vitest run --coverage --pool=forks --maxWorkers=1",
    "test:unit": "vitest run --exclude '**/__tests__/api/**'",
    "test:api": "vitest run src/__tests__/api",
    "test:watch": "vitest",
    "lint": "eslint src api --report-unused-disable-directives --max-warnings 10",
    "db:setup": "APP_ENV=dev tsx src/database/setup.ts",
    "vercel-build": "tsc && tsc-alias -p tsconfig.json && npm run openapi:copy",
    "env:sync": "node scripts/sync-vercel-env.mjs"
  },
  "dependencies": {
    "@google-analytics/data": "^7.3.0",
    "@google-cloud/storage": "^8.4.0",
    "@google/genai": "^2.31.0",
    "axios": "^1.21.0",
    "bcryptjs": "3.0.3",
    "compression": "^1.8.2",
    "cors": "2.8.6",
    "dayjs": "1.11.23",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mermaid": "12.2.0",
    "mongoose": "^9.11.4",
    "resend": "^6.35.0",
    "slugify": "1.6.9",
    "swagger-ui-express": "^5.0.1",
    "turndown": "^7.2.4",
    "yaml": "^1.10.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.6.5",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "17.13.0",
    "mongodb-memory-server": "^10.2.3",
    "nodemon": "3.1.14",
    "supertest": "^7.1.4",
    "tsc-alias": "^1.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "gaxios": "^7.1.5",
    "google-auth-library": "^10.7.0"
  }
}
