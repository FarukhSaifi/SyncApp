# Copy to .env.prod for local production builds — OR run: npm run env:pull (from repo root)
# Same keys as Vercel Production — see docs/VERCEL_ENV.md
# Placeholder values only — never commit real secrets.

NODE_ENV=production
PORT=9000

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/syncapp

JWT_SECRET=your_production_jwt_secret_min_32_chars

ENCRYPTION_KEY=your_production_64_char_hex_key
GCS_BUCKET_NAME=your-gcs-bucket-name

CORS_ORIGIN=https://your-frontend.example.com

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- AI (Vertex AI — preferred) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_AI_MODEL=gemini-3.8-flash
# Production needs SA JSON or WIF — user ADC does not work on Vercel.
# If org policy allows SA keys (paste the full JSON as one line; never commit real keys):
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-gcp-project-id","client_email":"sa@your-gcp-project-id.iam.gserviceaccount.com",...}
# If keys remain blocked, set up Workload Identity Federation (see docs/AI_SETUP.md).
# Studio fallback only (optional). Do not top up AI Studio billing:
# GEMINI_API_KEY=your-gemini-api-key-here
# Optional local-ADC signing override (rarely needed on Vercel with SA JSON):
# GCS_SIGNING_SERVICE_ACCOUNT=your-sa@your-gcp-project-id.iam.gserviceaccount.com

# Public blog base for LinkedIn “Read more” + article canonicals
# CANONICAL_BASE_URL=https://yourblog.example.com/blog

# Scheduled publish notifications — see docs/VERCEL_ENV.md
# RESEND_API_KEY=re_your_resend_api_key_here
# NOTIFICATION_FROM_EMAIL=SyncApp <noreply@yourdomain.example.com>
# NOTIFICATION_CC_EMAIL=you@example.com
# SLACK_WEBHOOK_URL=https://example.com/slack/incoming-webhook-placeholder
# SITE_URL=https://your-frontend.example.com
# Required in production (Bearer auth for /api/cron/*). Fail-closed when empty.
CRON_SECRET=your-cron-secret-here

# LinkedIn OAuth
# LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# LINKEDIN_REDIRECT_URI=https://your-api.example.com/api/linkedin/oauth/callback

# GA4 Data API — numeric property id only (see docs/GA4_SETUP.md). Not the G- measurement ID.
# GOOGLE_ANALYTICS_PROPERTY_ID=123456789
