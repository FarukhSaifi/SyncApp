# =============================================================================
# SyncApp mobile — environment template (placeholder values only)
# Copy to `.env` locally. Never commit real secrets or credential JSON.
# =============================================================================

# -----------------------------------------------------------------------------
# Client-side (EXPO_PUBLIC_* — embedded in the JS bundle; safe for non-secrets)
# Mobile talks to the API; it does NOT need GCS / GA4 / JWT / encryption keys.
# -----------------------------------------------------------------------------

# API (required for device / Expo Go builds pointing at your backend)
# Simulator: http://localhost:9000/api
# Physical device (LAN): http://<your-mac-lan-ip>:9000/api
# Production: https://your-api.example.com/api
EXPO_PUBLIC_API_BASE_URL=https://your-api.example.com/api

# Expo Router SDK 56+ React Navigation check disable
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1

# -----------------------------------------------------------------------------
# Build-time / EAS / native (not shipped as EXPO_PUBLIC; used by app.config / EAS)
# -----------------------------------------------------------------------------

# Apple — required for device builds and App Store (never commit real .env)
IOS_BUNDLE_IDENTIFIER=com.yourcompany.syncapp
APPLE_TEAM_ID=XXXXXXXXXX

# Android (optional — defaults to IOS_BUNDLE_IDENTIFIER)
# ANDROID_PACKAGE=com.yourcompany.syncapp

# Physical device install (optional — auto-detects first USB iPhone)
# EXPO_IOS_DEVICE=

# iOS native build (default: latest — see config/iosDefaults.ts)
IOS_DEPLOYMENT_TARGET=26.0
IOS_BUILD_NUMBER=1
# IOS_SUPPORTS_TABLET=true
# IOS_BUILD_CONFIGURATION=Release
# IOS_REGEN=1

# EAS — set EXPO_PUBLIC_API_BASE_URL + IOS_BUNDLE_IDENTIFIER as EAS secrets for production
# Optional override — default is in config/app.ts (run `npm run eas:init` from repo root)
# EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# App Store submit (optional — copy eas.submit.example.json → eas.submit.json, gitignored)
# APPLE_ID=you@example.com
# ASC_APP_ID=0000000000

# -----------------------------------------------------------------------------
# Server-only (document for operators — set on server / Vercel, NOT in mobile .env)
# See docs/VERCEL_ENV.md and docs/GA4_SETUP.md. Mobile consumes these via API.
# -----------------------------------------------------------------------------
#
# GCS_BUCKET_NAME=                 # cover / media bucket
# GCS_SIGNING_SERVICE_ACCOUNT=     # optional; SA email for V4 signed uploads when using user ADC
#                                  # (defaults to syncapp-vertex-ai@… on local ADC; not needed when
#                                  # GOOGLE_CREDENTIALS_JSON is a service-account key)
# GOOGLE_CLOUD_PROJECT=            # e.g. syncapp-ai (Vertex + GCS)
# GOOGLE_CLOUD_LOCATION=           # e.g. us-central1
# GOOGLE_CREDENTIALS_JSON=         # SA JSON on Vercel (never commit)
# GOOGLE_ANALYTICS_PROPERTY_ID=    # numeric GA4 property id (not G-…); admin website analytics
# CANONICAL_BASE_URL=              # public blog base for LinkedIn Read more + canonicals
# MONGODB_URI= JWT_SECRET= ENCRYPTION_KEY= CORS_ORIGIN= CRON_SECRET=
# LINKEDIN_CLIENT_ID= LINKEDIN_CLIENT_SECRET= LINKEDIN_REDIRECT_URI=
# RESEND_API_KEY= NOTIFICATION_FROM_EMAIL= SLACK_WEBHOOK_URL= SITE_URL=
