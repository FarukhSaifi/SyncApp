{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "axios": "^1.20.0",
    "babel-preset-expo": "^57.0.11",
    "dayjs": "^1.11.23",
    "expo": "^57.0.22",
    "expo-blur": "^57.0.3",
    "expo-build-properties": "^57.0.17",
    "expo-constants": "^57.0.18",
    "expo-dev-client": "^57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "^57.0.10",
    "expo-router": "^57.0.21",
    "expo-secure-store": "^57.0.4",
    "expo-splash-screen": "^57.0.9",
    "expo-status-bar": "^57.0.1",
    "qs": "^6.15.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "^0.87.1",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "^0.12.2"
  },
  "devDependencies": {
    "@types/qs": "^6.15.1",
    "@types/react": "19.3.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/ensure-expo-module-scripts-tsconfig.mjs",
    "dev": "expo start",
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "start:dev-client": "expo start --dev-client",
    "start:go": "expo start --go",
    "eas": "npx eas",
    "build:android:apk": "npx eas build --platform android --profile preview",
    "build:ios:sim": "npx eas build --platform ios --profile preview-simulator",
    "build:ios": "npx eas build --platform ios --profile production",
    "build:ios:preview": "npx eas build --platform ios --profile preview",
    "submit:ios": "npx eas submit --platform ios --profile production",
    "build:ios:submit": "npx eas build --platform ios --profile production --auto-submit"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
    }
  },
  "private": true
}
