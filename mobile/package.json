{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "axios": "^1.20.0",
    "babel-preset-expo": "~58.0.0",
    "dayjs": "^1.11.23",
    "expo": "~58.0.19",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "qs": "^6.16.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-freeze": "^1.0.4",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-gifted-charts": "^1.4.81",
    "react-native-is-edge-to-edge": "^1.3.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-toast-message": "^2.5.2",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "^0.13.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/qs": "^6.15.1",
    "@types/react": "~19.3.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/ensure-expo-module-scripts-tsconfig.mjs",
    "dev": "expo start",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "start:dev-client": "expo start --dev-client",
    "start:go": "expo start --go",
    "eas": "npx eas",
    "build:android:apk": "npx eas build --platform android --profile preview",
    "build:ios:sim": "npx eas build --platform ios --profile preview-simulator",
    "build:ios": "npx eas build --platform ios --profile production",
    "build:ios:preview": "npx eas build --platform ios --profile preview",
    "submit:ios": "npx eas submit --platform ios --profile production",
    "build:ios:submit": "npx eas build --platform ios --profile production --auto-submit"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
    }
  },
  "private": true
}
