{
  "name": "syncapp",
  "version": "2.0.0",
  "description": "Blog syndication application for publishing to multiple platforms",
  "private": true,
  "engines": {
    "node": ">=24.21.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.13.0"
    }
  },
  "workspaces": [
    "client",
    "server",
    "mobile"
  ],
  "scripts": {
    "dev:mobile": "turbo run dev --filter=mobile",
    "ios:device": "cd mobile && npm run ios:device",
    "build:ios": "cd mobile && npm run build:ios",
    "build:ios:submit": "cd mobile && npm run build:ios:submit",
    "submit:ios": "cd mobile && npm run submit:ios",
    "eas:init": "cd mobile && npx eas init",
    "eas:whoami": "cd mobile && npx eas whoami",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "env:pull": "npm run env:pull:server && npm run env:pull:client",
    "env:pull:server": "cd server && vercel env pull .env.prod --environment=production",
    "env:pull:client": "cd client && vercel env pull .env.production --environment=production",
    "test": "turbo run test --filter=server --filter=client",
    "check": "turbo run typecheck lint",
    "audit:all": "npm audit --audit-level=high --workspaces",
    "clean": "node scripts/cleanup.mjs",
    "clean:deps": "node scripts/cleanup.mjs --deps",
    "clean:native": "node scripts/cleanup.mjs --native",
    "clean:all": "node scripts/cleanup.mjs --all"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
